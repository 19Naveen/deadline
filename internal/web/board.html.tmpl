<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>gotodo · {{.Kind}} board</title>
<style nonce="{{.Nonce}}">
  :root {
    --bg: #16181d; --panel: #1e2128; --text: #e6e9ef; --muted: #7a8290;
    --border: #3a4150; --accent: #7aa2f7; --amber: #e0af68; --red: #f7768e; --green: #9ece6a;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 14px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  header { display: flex; gap: 1rem; align-items: baseline; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--border); }
  header h1 { margin: 0; font-size: 1rem; color: var(--accent); }
  header .meta { color: var(--muted); }
  .gate { color: var(--amber); }
  main { display: flex; gap: 0.8rem; padding: 1rem; overflow-x: auto; align-items: flex-start; }
  .col { flex: 1 0 15rem; min-width: 15rem; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 0.6rem; }
  .col h2 { margin: 0 0 0.6rem; font-size: 0.85rem; letter-spacing: 0.05em; }
  .col h2 .count { color: var(--muted); font-weight: normal; }
  .role-todo h2 { color: var(--accent); }
  .role-active h2 { color: var(--amber); }
  .role-blocked h2 { color: var(--red); }
  .role-done h2 { color: var(--green); }
  .over h2 .count { color: var(--red); }
  .card { border-left: 2px solid var(--border); padding: 0.35rem 0.5rem; margin-bottom: 0.5rem; }
  .card .title { font-weight: bold; word-wrap: break-word; }
  .card .line { color: var(--muted); font-size: 0.8rem; margin-top: 0.15rem; }
  .cd { font-weight: bold; float: right; }
  .u-future { color: var(--green); font-weight: normal; }
  .u-soon { color: var(--amber); }
  .u-urgent, .u-overdue { color: var(--red); }
  .p-high { color: var(--red); } .p-medium { color: var(--amber); } .p-low { color: var(--accent); }
  .label { display: inline-block; border: 1px solid var(--border); border-radius: 3px; padding: 0 0.3rem; margin-right: 0.2rem; color: var(--text); }
  .empty { color: var(--muted); font-style: italic; }
  a { color: var(--accent); }
</style>
</head>
<body data-version="{{.Version}}">
<header>
  <h1>gotodo</h1>
  <span class="meta">{{.Kind}} board · read-only · updated {{.GeneratedAt}}</span>
  {{if .RequireApproval}}<span class="gate">shipping needs human approval</span>{{end}}
</header>
<main>
{{range .Columns}}
  <section class="col role-{{.Role}}{{if and .WIPLimit (gt (len .Cards) .WIPLimit)}} over{{end}}">
    <h2>{{.Label}} <span class="count">{{len .Cards}}{{if .WIPLimit}}/{{.WIPLimit}}{{end}}</span></h2>
    {{range .Cards}}
    <article class="card" id="t-{{.ShortID}}">
      {{if .Countdown}}<span class="cd u-{{.Urgency}}">{{.Countdown}}</span>{{end}}
      <div class="title">{{.Title}}</div>
      <div class="line">{{.ShortID}}{{if .Priority}} · <span class="p-{{.Priority}}">{{.Priority}}</span>{{end}}{{if .Deadline}} · due {{.Deadline}}{{end}}</div>
      {{if .Labels}}<div class="line">{{range .Labels}}<span class="label">{{.}}</span>{{end}}</div>{{end}}
      {{if .ClaimedBy}}<div class="line">claimed by {{.ClaimedBy}}{{if .ClaimUntil}} until {{.ClaimUntil}}{{end}}</div>{{end}}
      {{if .PRURL}}<div class="line">PR <a href="{{.PRURL}}" target="_blank" rel="noopener noreferrer">{{.PRURL}}</a></div>{{else if .PR}}<div class="line">PR #{{.PR}}</div>{{end}}
      {{if .BlockedBy}}<div class="line">waiting on {{len .BlockedBy}} task(s)</div>{{end}}
      {{if .LastAgent}}<div class="line">last moved by {{.LastAgent}}</div>{{end}}
    </article>
    {{else}}
    <div class="empty">empty</div>
    {{end}}
  </section>
{{end}}
</main>
<script nonce="{{.Nonce}}">
(function () {
  var version = document.body.getAttribute("data-version");
  function poll() {
    fetch("/api/board", { cache: "no-store" })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) { if (d && d.version !== version) { location.reload(); } })
      .catch(function () {});
  }
  setInterval(poll, 5000);
})();
</script>
</body>
</html>
